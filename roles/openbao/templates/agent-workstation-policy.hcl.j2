{{ ansible_managed | comment }}
# OpenBao policy for the `agent-workstation` AppRole.
path "{{ openbao_kv_mount }}/data/apps/nautobot" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/data/ai/mcp" {
  capabilities = ["read"]
}
# Zammad MCP token and URL for workstation sessions.
path "{{ openbao_kv_mount }}/data/ai/mcp/zammad" {
  capabilities = ["read"]
}
# Vikunja MCP token and URL for workstation sessions.
path "{{ openbao_kv_mount }}/data/ai/mcp/vikunja" {
  capabilities = ["read"]
}
# YouTrack service API token for agent use.
path "{{ openbao_kv_mount }}/data/ai/youtrack" {
  capabilities = ["read"]
}
# Dify agent app API keys.
path "{{ openbao_kv_mount }}/data/ai/dify/agent-apps/*" {
  capabilities = ["read"]
}
# Slack reader token for the hourly agent read.
path "secrets-external/data/slack/claude-reader/ro" {
  capabilities = ["read"]
}
