{{ ansible_managed | comment }}
# Sandbox read access and public repository read tokens.
path "{{ openbao_kv_mount }}/data/apps/sandbox-agent" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/data/apps/sandbox-agent-router" {
  capabilities = ["read"]
}

path "{{ openbao_github_agents_mount }}/token/public-read" {
  capabilities = ["create", "update"]
}
{% for owner in openbao_github_agents_public_owner_set_inputs | default([]) %}
path "{{ openbao_github_agents_mount }}/token/public-read-{{ owner | lower }}" {
  capabilities = ["create", "update"]
}
{% endfor -%}
