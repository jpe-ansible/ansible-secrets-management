{{ ansible_managed | comment }}
# OpenBao policy for the approle-secret-id-rotate AppRole — INERT (no
# standing secret_id; see the AppRole row in
# defaults/main/07e-rotation-approles.yml), same human-gated shape as
# ai-rotate/apps-rotate: an operator wraps a single-use secret_id, this
# identity's own login unwraps it, and the resulting token lives exactly one
# rotation run (playbooks/openbao-rotate-approles.yml).
#
# Narrower than approle-issuer on purpose: approle-issuer may MINT a
# secret-id for every issuable role in the cluster, but holds neither the
# destroy capability nor the env-document write below — minting a fresh
# credential and retiring the old one for the explicit rotation catalogs is
# a separate, smaller power from "can hand out a working credential for
# anything". Scoped by name, not a wildcard, so this identity cannot touch
# any other AppRole in the cluster.
#
# The scheduled identity renders this with scheduled_only (07c): it rotates the
# domain catalog and its own role, and never mints a host secret-zero identity,
# so a dead or missing one needs the human-gated identity.
{% set _scheduled_only = (item | default({})).scheduled_only | default(false) | bool %}
{% set _mintable = openbao_secrets_domain_approle_names
     + ([openbao_approle_secret_id_rotate_scheduled_approle_name]
        if _scheduled_only else [])
     + ([] if _scheduled_only else openbao_host_secret_zero_approle_names) %}
{% for approle_name in _mintable | unique %}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ approle_name }}/secret-id" {
  capabilities = ["create", "update"]
}
path "auth/approle/role/{{ approle_name }}/secret-id/lookup" {
  capabilities = ["update"]
}
path "auth/approle/role/{{ approle_name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
{% endfor %}

# The rotation play probes the two roster key readers by exact role-id read
# to decide whether the published inventory must be loaded before rotating.
{% for approle_name in [openbao_roster_router_key_reader_name, openbao_roster_gateway_key_reader_name]
   | reject('in', _mintable) %}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["read"]
}
{% endfor %}

# The one KV document holding these domains' OPENBAO_APPROLE_<NAME>_{ROLE,
# SECRET}_ID pairs written to platform/ansible/env.
# read+update, CAS write only (the rotation playbook always reads the
# current version and writes back with `options.cas` pinned to it) -- no
# `create`, so this identity can never seed the document into existence,
# only rotate an entry that is already there.
path "{{ openbao_kv_mount }}/data/platform/ansible/env" {
  capabilities = ["read", "update"]
}

path "{{ openbao_kv_mount }}/metadata/platform/ansible/env" {
  capabilities = ["read"]
}

# The Doppler service token this identity presents to republish
# openbao_rotate_doppler_sync_domains' pairs into Doppler (see
# 08c-rotator-doppler-sync.yml). Read-only: this identity never writes or
# rotates that token itself.
path "{{ openbao_kv_mount }}/data/{{ openbao_rotate_doppler_token_kv_path }}" {
  capabilities = ["read"]
}

# The scheduled identity is included in `_mintable` above for self-rotation.
# Its source-address CIDR binding is the control on a leaked pair, not this
# grant.
{% if not _scheduled_only %}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id" {
  capabilities = ["create", "update"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id/lookup" {
  capabilities = ["update"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
{% endif %}
{% set _kv_rotation_write_paths = [] -%}
{% set _kv_rotation_metadata_paths = [] -%}
{% set _kv_rotation_read_paths = [] -%}
{% for target in openbao_kv_rotation_targets | default([]) -%}
{%- set _data_path = target.mount ~ '/data/' ~ target.path -%}
{%- set _metadata_path = target.mount ~ '/metadata/' ~ target.path -%}
{%- if _data_path not in _kv_rotation_write_paths -%}
{%- set _ = _kv_rotation_write_paths.append(_data_path) -%}
{%- endif -%}
{%- if _metadata_path not in _kv_rotation_metadata_paths -%}
{%- set _ = _kv_rotation_metadata_paths.append(_metadata_path) -%}
{%- endif -%}
{%- if target.generate.kind == 'vendor_roll' -%}
{%- set _admin_path = target.generate.admin_credential.mount ~ '/data/' ~ target.generate.admin_credential.path -%}
{%- if _admin_path not in _kv_rotation_write_paths and _admin_path not in _kv_rotation_read_paths -%}
{%- set _ = _kv_rotation_read_paths.append(_admin_path) -%}
{%- endif -%}
{%- endif -%}
{% endfor -%}
{% set _semaphore_token = openbao_kv_rotation_semaphore_token | default({}) -%}
{% set _semaphore_token_complete = (
  _semaphore_token is mapping
  and _semaphore_token.get('mount', '') is string
  and _semaphore_token.get('mount', '') is match('^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$')
  and '..' not in _semaphore_token.get('mount', '').split('/')
  and _semaphore_token.get('path', '') is string
  and _semaphore_token.get('path', '') is match('^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$')
  and '..' not in _semaphore_token.get('path', '').split('/')
  and _semaphore_token.get('field', '') is string
  and _semaphore_token.get('field', '') is match('^[A-Za-z0-9._-]+$')
) -%}
{% if (openbao_kv_rotation_targets | default([]) | selectattr('push.kind', 'equalto', 'semaphore') | list | length > 0)
   and _semaphore_token_complete -%}
{%- set _semaphore_path = _semaphore_token.mount ~ '/data/' ~ _semaphore_token.path -%}
{%- if _semaphore_path not in _kv_rotation_write_paths and _semaphore_path not in _kv_rotation_read_paths -%}
{%- set _ = _kv_rotation_read_paths.append(_semaphore_path) -%}
{%- endif -%}
{% endif -%}
{% set _terrakube_token = openbao_kv_rotation_terrakube_token | default({}) -%}
{% set _terrakube_token_complete = (
  _terrakube_token is mapping
  and _terrakube_token.get('mount', '') is string
  and _terrakube_token.get('mount', '') is match('^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$')
  and '..' not in _terrakube_token.get('mount', '').split('/')
  and _terrakube_token.get('path', '') is string
  and _terrakube_token.get('path', '') is match('^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$')
  and '..' not in _terrakube_token.get('path', '').split('/')
  and _terrakube_token.get('field', '') is string
  and _terrakube_token.get('field', '') is match('^[A-Za-z0-9._-]+$')
) -%}
{% if (openbao_kv_rotation_targets | default([]) | selectattr('push.kind', 'equalto', 'terrakube') | list | length > 0)
   and _terrakube_token_complete -%}
{%- set _terrakube_path = _terrakube_token.mount ~ '/data/' ~ _terrakube_token.path -%}
{%- if _terrakube_path not in _kv_rotation_write_paths and _terrakube_path not in _kv_rotation_read_paths -%}
{%- set _ = _kv_rotation_read_paths.append(_terrakube_path) -%}
{%- endif -%}
{% endif -%}
{% for path in _kv_rotation_write_paths -%}
path "{{ path }}" {
  capabilities = ["read", "create", "update"]
}
{% endfor -%}
{% for path in _kv_rotation_metadata_paths -%}
path "{{ path }}" {
  capabilities = ["read"]
}
{% endfor -%}
{% for path in _kv_rotation_read_paths -%}
path "{{ path }}" {
  capabilities = ["read"]
}
{% endfor -%}
