{{ ansible_managed | comment }}
# OpenBao policy for the ntfy AppRole (openbao_secrets domain "ntfy") — the
# ntfy alert hub's Slack fan-out (ntfy_docker role). It reads only the
# ext-notify webhook leaf. No access to secret/apps or other domain credentials.

# The Slack incoming-webhook leaf, keyed by topic.
path "ext-notify/data/slack/webhooks/rw" {
  capabilities = ["read"]
}

path "ext-notify/metadata/slack/webhooks/rw" {
  capabilities = ["read", "list"]
}
