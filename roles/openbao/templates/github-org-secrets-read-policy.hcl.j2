{{ ansible_managed | comment }}
# Read only the declared org-secrets KV-v2 source leaves.
path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_disclosure_denylist_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_gitleaks_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_release_key_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_dify_pr_keeper_webhook_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_pr_reconcile_exclude_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_github_org_secrets_mount }}/data/{{ openbao_github_org_openrouter_provisioning_path }}" {
  capabilities = ["read"]
}
{# Estate-specific leaves arrive at converge time. #}{% for path in openbao_github_org_secrets_extra_read_paths | default([]) %}

path "{{ path.split('/', 1) | join('/data/') }}" {
  capabilities = ["read"]
}
{% endfor -%}
