{{ ansible_managed | comment }}
# Finite exact-name grants used by the selected ai-admin-session RBAC path.
# Policy contents and AppRole parameters are not pinned.
# This policy is paired with ai-admin-guard; it has no wildcard policy write
# path. Its wildcard write paths are AppRole configuration at depth one and the
# GitHub Actions OIDC role path, limited by the policies a role may attach.

path "sys/capabilities-self" {
  capabilities = ["create", "update"]
}
path "sys/policies/acl" {
  capabilities = ["list"]
}
# Policy text for the before/after diff of a selected run. The operator's
# unlock policies and the guard stay unreadable.
path "sys/policies/acl/*" {
  capabilities = ["read"]
}
path "sys/policies/acl/{{ openbao_human_unlock_policy_name }}*" {
  capabilities = ["deny"]
}
path "sys/policies/acl/{{ openbao_ai_admin_guard_policy_name }}" {
  capabilities = ["deny"]
}

# AppRole configuration at depth one, written and read back without delete.
# role-id and secret-id subpaths and the guarded roles stay under the guard's deny.
path "auth/approle/role" {
  capabilities = ["list"]
}
path "auth/approle/role/+" {
  capabilities = ["create", "read", "update"]
}

{% for _policy in openbao_ai_admin_window_grant_policies %}
path "sys/policies/acl/{{ _policy.name }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}

{% for _approle in openbao_ai_admin_window_grant_approles %}
path "auth/approle/role/{{ _approle.name }}" {
  capabilities = ["create", "read", "update"]
}
path "auth/approle/role/{{ _approle.name }}/policies" {
  capabilities = ["create", "update"]
}
{% endfor %}

# GitHub Actions OIDC roles. Each role may attach only one declared OIDC-role
# policy, by exact name, so no role can carry a guarded or self-protecting
# policy. Delete stays denied.
path "auth/{{ openbao_github_oidc_auth_path }}/role/*" {
  capabilities = ["create", "read", "update"]
  allowed_parameters = {
    "*" = []
    "token_policies" = {{ openbao_ai_admin_window_oidc_role_policies | tojson }}
    "policies" = {{ openbao_ai_admin_window_oidc_role_policies | tojson }}
  }
  # Group and alias-metadata claims would let a role reach identity groups or
  # templated policies beyond its one declared policy.
  denied_parameters = {
    "groups_claim" = []
    "claim_mappings" = []
  }
}
path "auth/{{ openbao_github_oidc_auth_path }}/role" {
  capabilities = ["list"]
}
