{{ ansible_managed | comment }}
# OpenBao policy for the semaphore AppRole — the DELTA over ansible-converge,
# not a replacement for it. The semaphore AppRole attaches both: every path a
# converge already reads comes from ansible-converge-policy.hcl.j2, and this
# file adds only what a Semaphore-driven run needs on top. Splitting it this
# way keeps one consumer inventory rather than two copies that drift.
#
# Why a separate identity at all, when the same playbooks run from a laptop
# under ansible-converge: the two callers are not equally trusted. A Semaphore
# run is unattended, triggered by anyone who can reach the web UI or its API,
# and its bootstrap credential sits in a database on the platform VM. A laptop
# run is a human at a terminal holding secret-zero. Giving them one identity
# means the unattended path silently inherits every grant the interactive one
# ever gains.
#
# ENUMERATED exact paths only — no platform/* or apps/* wildcard, matching the
# ansible-converge convention. Each entry names the call site that reads it; a
# path with no named consumer does not belong here.
#
#   platform/splunk/main
#     ansible-splunk's converge reads the Splunk and Splunkbase credentials it
#     used to receive as ambient environment variables from a laptop secrets
#     manager, and which an unattended run therefore could not reach at all.
#     Read-only: these are provisioned out of band and a converge must never
#     rewrite the account it authenticates as. Call sites:
#       ansible-splunk  playbooks/site.yml                       (SPLUNK_PASSWORD,
#                                                                 SPLUNK_HEC_TOKEN,
#                                                                 HEC_NAMESPACE)
#       ansible-splunk  playbooks/tasks/sync-splunkbase/preflight.yml
#                                                                (SPLUNKBASE_USERNAME,
#                                                                 SPLUNKBASE_PASSWORD)
#
# NO OBJECT-STORAGE GRANT HERE, DELIBERATELY, AND IT IS NOT AN OVERSIGHT.
# The Splunkbase mirror writes to the artifact bucket, so it needs an
# object-storage credential — but ansible-converge, which this AppRole also
# attaches, already grants the path the mirror reads. A second grant here would
# widen nothing and only add a place to keep in sync.
#
# The longer-term intent is a bucket-scoped read-write key per workload, per
# the one-bucket-per-workload rule, rather than the shared credential in use
# today. That is blocked on the object store rather than on policy: the
# deployed version implements neither an IAM nor an STS API, so there is no
# second credential to mint and no role to assume — verified against the
# running service, not inferred from its documentation. When the store gains
# one, the scoped key lands at apps/splunkbase-mirror and gets its own stanza
# here.

path "{{ openbao_kv_mount }}/data/platform/splunk/main" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/platform/splunk/main" {
  capabilities = ["read", "list"]
}

# ansible-proxmox-ai's router secret prefetch consumes these two app entries.
path "{{ openbao_kv_mount }}/data/apps/benchmark" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/benchmark" {
  capabilities = ["read", "list"]
}

path "{{ openbao_kv_mount }}/data/apps/sandbox-agent" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/sandbox-agent" {
  capabilities = ["read", "list"]
}

# Grafana/vmauth's converge and the Semaphore proof read these generated
# credentials from their exact app leaves.
path "{{ openbao_kv_mount }}/data/apps/agent-quota" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/agent-quota" {
  capabilities = ["read", "list"]
}

path "{{ openbao_kv_mount }}/data/apps/metrics-reader" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/metrics-reader" {
  capabilities = ["read", "list"]
}

# The Nautobot drift report reads its dedicated pipeline token. Keep this exact
# leaf on the Semaphore delta; it does not need the optional sync-write token.
# Call site: ansible-proxmox-apps playbooks/nautobot-drift.yml.
path "{{ openbao_kv_mount }}/data/apps/nautobot/pipeline" {
  capabilities = ["read"]
}

# Cribl pack discovery and the pull-request census select an org through the
# App installation. Pin each raw request to one of its exact read maps and
# forbid repository or installation selectors.
{% set _semaphore_raw_maps = [openbao_semaphore_github_raw_read_permissions]
   + ([openbao_semaphore_github_census_read_permissions]
      if (openbao_semaphore_github_census_read_permissions | default({})) else []) %}
path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["org_name", "permissions"]
  allowed_parameters = {
    "org_name" = []
    "permissions" = [{% for map in _semaphore_raw_maps %}{ {% for name, level in map | dictsort %}"{{ name }}" = "{{ level }}"{{ ", " if not loop.last else "" }}{% endfor %} }{{ ", " if not loop.last else "" }}{% endfor %}]
  }
  denied_parameters = {
    "repositories" = []
    "repository_ids" = []
    "installation_id" = []
  }
}

# The execution plane checks out repositories from installed organizations via
# its git credential helper. The raw-token grant above pins its read map while
# letting the request select the organization by name; the named set below
# serves the helper until it switches to that grant.
{% for permission_set in openbao_semaphore_github_read_permission_sets %}
path "{{ openbao_github_everyday_mount }}/token/{{ permission_set }}" {
  capabilities = ["create", "update"]
}
{% endfor %}

{% if openbao_github_dispatch_permission_sets | length > 0 %}
path "{{ openbao_github_mount }}/token/workflow-dispatch" {
  capabilities = ["read", "create", "update"]
}
{% endif %}
