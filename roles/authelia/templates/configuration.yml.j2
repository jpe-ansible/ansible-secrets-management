{{ ansible_managed | comment }}
# Authelia configuration — passkey-first SSO portal + Traefik forwardAuth
# provider. Single instance: in-memory session provider (a restart re-prompts
# the browser; acceptable for a homelab) and local SQLite on the persistent
# data mount. NO secrets live in this file — the JWT/session/storage secrets
# are guest-generated files fed via AUTHELIA_*_FILE env vars in the systemd
# unit (generate-at-source rule; no shared secret store involved).

theme: auto

server:
  address: "tcp://0.0.0.0:{{ authelia_port }}"
  endpoints:
    # Each bucket refills one request per period (burst = requests); Authelia
    # rejects a period under 10s. The defaults leave a client IP about one
    # token-endpoint call per 10 minutes once spent, which a device-code client
    # polling every 10s exhausts in one approval.
    rate_limits:
      openid_connect_token:
        buckets:
          - period: 10s
            requests: 60

log:
  level: info

authentication_backend:
  file:
    path: "{{ authelia_users_file }}"

# Requiring user verification asks the authenticator to verify the user (e.g.,
# with Touch ID) on every assertion, and fails if it cannot. With the
# experimental UV two-factor option, a verified passkey satisfies two_factor
# in one gesture, without a separate password prompt. Passkey login only finds
# credentials stored as discoverable: registration requires a discoverable
# credential, and the experimental upgrade option records a new credential as
# a passkey when the browser does not report that it is one.
webauthn:
  disable: false
  enable_passkey_login: true
  experimental_enable_passkey_uv_two_factors: true
  experimental_enable_passkey_upgrade: true
  selection_criteria:
    discoverability: '{{ authelia_webauthn_discoverability }}'
    user_verification: '{{ authelia_webauthn_user_verification }}'

# Native OIDC is required by Hermes Dashboard before it will bind beyond
# loopback. The client is public and PKCE-only; no reusable client secret exists.
identity_providers:
  oidc:
    hmac_secret: '{{ authelia_oidc_hmac_secret }}'
    jwks:
      - algorithm: RS256
        use: sig
        key: |
{{ authelia_oidc_jwks_key | indent(10, true) }}
    enforce_pkce: public_clients_only
    # Semaphore and terrakube-dex (Dex) both need `groups` in the id_token to
    # gate access on group membership; the default claims set omits it.
    claims_policies:
      semaphore_claims_policy:
        id_token:
          - groups
          - email
          - email_verified
          - preferred_username
          - name
      # Leantime's claims policy, from the same guide as its client block below.
      leantime_claims_policy:
        id_token:
          - email
    # Device codes are bearer-equivalent until approved. One hour bounds the window in
    # which a code sent to the approval channel can be approved (default is 10m); it
    # matches the final one-hour approval link the unlock helper sends.
    lifespans:
      device_code: 1h
{% if authelia_bao_elevation_enabled %}
    # OpenBao login approval. Only the device-code clients below use this policy.
    # Deny by default; the one rule admits the operator, from the approval
    # networks only. The rule has no fallback, so an empty network list must be
    # refused before render (see tasks/oidc_client_secrets.yml).
    authorization_policies:
      elevate:
        default_policy: deny
        rules:
          - policy: two_factor
            subject: '{{ authelia_approve_subject }}'
            networks:
{% for n in authelia_approve_networks %}
              - '{{ n }}'
{% endfor %}
{% endif %}
    clients:
      - client_id: '{{ authelia_oidc_hermes_client_id }}'
        client_name: Hermes Dashboard
        public: true
        redirect_uris:
          - '{{ authelia_oidc_hermes_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: none
      - client_id: '{{ authelia_oidc_donna_client_id }}'
        client_name: Donna Dashboard
        public: true
        redirect_uris:
          - '{{ authelia_oidc_donna_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: none
      # Homarr, Langfuse, Semaphore, and terrakube-dex are confidential clients
      # (server-side apps that can hold a secret), so client_secret carries a
      # pbkdf2-sha512 digest (never plaintext) and there is no PKCE. Homarr
      # additionally disables signed token/userinfo responses per Authelia's
      # own documented Homarr integration — its OIDC client does not support
      # OpenID Connect's signed-response mode.
      - client_id: '{{ authelia_oidc_homarr_client_id }}'
        client_name: Homarr
        client_secret: '{{ authelia_oidc_client_secret_hashes.homarr }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_homarr_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
      - client_id: '{{ authelia_oidc_langfuse_client_id }}'
        client_name: Langfuse
        client_secret: '{{ authelia_oidc_client_secret_hashes.langfuse }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_langfuse_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_phoenix_client_id }}'
        client_name: Arize Phoenix
        client_secret: '{{ authelia_oidc_client_secret_hashes.phoenix }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_phoenix_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      # Semaphore and terrakube-dex (Dex) both read `groups` from the id_token
      # to gate access, hence claims_policy; neither supports a signed
      # userinfo response, same as Homarr above.
      - client_id: '{{ authelia_oidc_semaphore_client_id }}'
        client_name: Semaphore
        client_secret: '{{ authelia_oidc_client_secret_hashes.semaphore }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_semaphore_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        claims_policy: semaphore_claims_policy
        userinfo_signed_response_alg: none
      - client_id: '{{ authelia_oidc_terrakube_dex_client_id }}'
        client_name: Terrakube Dex
        client_secret: '{{ authelia_oidc_client_secret_hashes.terrakube_dex }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_terrakube_dex_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
        claims_policy: semaphore_claims_policy
        userinfo_signed_response_alg: none
      # Grafana reads no groups claim — its generic_oauth backend maps every
      # SSO user to a fixed role via role_attribute_path, so this client needs
      # neither the groups scope nor a claims policy.
      - client_id: '{{ authelia_oidc_grafana_client_id }}'
        client_name: Grafana
        client_secret: '{{ authelia_oidc_client_secret_hashes.grafana }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_grafana_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      # LiteLLM reads no groups claim and needs no custom claims policy; its
      # SSO callback is served by the LiteLLM proxy itself.
      - client_id: '{{ authelia_oidc_litellm_client_id }}'
        client_name: LiteLLM
        client_secret: '{{ authelia_oidc_client_secret_hashes.litellm }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_litellm_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_youtrack_client_id }}'
        client_name: YouTrack
        client_secret: '{{ authelia_oidc_client_secret_hashes.youtrack }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_youtrack_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_vikunja_client_id }}'
        client_name: Vikunja
        client_secret: '{{ authelia_oidc_client_secret_hashes.vikunja }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_vikunja_redirect_uri }}'
        scopes:
          - openid
          - profile
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: false
        token_endpoint_auth_method: client_secret_basic
      # Leantime only: client_secret_post and PKCE S256 per Authelia's Leantime guide, not client_secret_basic.
      - client_id: '{{ authelia_oidc_leantime_client_id }}'
        client_name: Leantime
        client_secret: '{{ authelia_oidc_client_secret_hashes.leantime }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_leantime_redirect_uri }}'
        scopes:
          - openid
          - groups
          - email
          - profile
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: client_secret_post
        claims_policy: leantime_claims_policy
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
{% if authelia_oidc_openbao_ui_enabled | bool %}
      # OpenBao UI and CLI use the same confidential authorization-code client.
      # Authelia includes the groups and preferred_username claims OpenBao binds.
      - client_id: '{{ authelia_oidc_openbao_ui_client_id }}'
        client_name: OpenBao UI
        client_secret: '{{ authelia_oidc_client_secret_hashes.openbao_ui }}'
        public: false
        redirect_uris:
          - '{{ authelia_oidc_openbao_ui_redirect_uri }}'
          - '{{ authelia_oidc_openbao_cli_redirect_uri }}'
        scopes:
          - openid
          - profile
          - groups
          - email
        grant_types:
          - authorization_code
        response_types:
          - code
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: client_secret_basic
        claims_policy: semaphore_claims_policy
{% endif %}
{% if authelia_bao_elevation_enabled %}
      # OpenBao login approval clients. Device-code grant only: no redirect URI
      # and no authorization-code grant, so neither can drive a browser redirect.
      # consent_mode explicit makes each approval an affirmative action on the
      # approval page, which shows client_name. Scope and networks are enforced by
      # the elevate authorization policy above.
      - client_id: '{{ authelia_oidc_bao_elevate_trusted_client_id }}'
        client_name: OpenBao elevation (trusted)
        client_secret: '{{ authelia_oidc_client_secret_hashes.bao_elevate_trusted }}'
        public: false
        scopes:
          - openid
          - profile
          - groups
        grant_types:
          - urn:ietf:params:oauth:grant-type:device_code
        consent_mode: explicit
        authorization_policy: elevate
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_bao_elevate_policy_sync_client_id }}'
        client_name: OpenBao policy sync
        client_secret: '{{ authelia_oidc_client_secret_hashes.bao_elevate_policy_sync }}'
        public: false
        scopes:
          - openid
          - profile
          - groups
        grant_types:
          - urn:ietf:params:oauth:grant-type:device_code
        consent_mode: explicit
        authorization_policy: elevate
        token_endpoint_auth_method: client_secret_basic
      - client_id: '{{ authelia_oidc_bao_elevate_untrusted_client_id }}'
        client_name: OpenBao elevation (untrusted)
        public: true
        scopes:
          - openid
          - profile
          - groups
        grant_types:
          - urn:ietf:params:oauth:grant-type:device_code
        consent_mode: explicit
        authorization_policy: elevate
        token_endpoint_auth_method: none
{% endif %}

access_control:
  default_policy: deny
  rules:
{% for bypass in authelia_api_bypass_domains %}
    # {{ bypass.domain }} authenticates this path prefix itself (per-request
    # token); the portal cannot satisfy a non-browser client. UI paths stay
    # gated below. The prefix is per-entry: an app that serves its browser auth
    # routes under /api must narrow it so the bypass does not expose them.
    - domain: "{{ bypass.domain }}"
      policy: bypass
      resources:
        - "{{ bypass.resource | default(authelia_api_bypass_default_resource) }}"
{% endfor %}
{% if authelia_wall_kiosk_networks | default([]) | length > 0 %}
    # Display-only kiosks: the wall host, from the kiosk clients only.
    - domain:
{% for d in authelia_wall_kiosk_domains %}
        - "{{ d }}"
{% endfor %}
      policy: bypass
      networks:
{% for n in authelia_wall_kiosk_networks %}
        - "{{ n }}"
{% endfor %}
{% endif %}
    # Every Traefik-fronted UI under the ingress base domain. two_factor is
    # required so Authelia exposes passkey/WebAuthn enrolment at all (it hides
    # it when nothing needs a second factor); a UV passkey satisfies it in one
    # Touch ID gesture via webauthn.experimental_enable_passkey_uv_two_factors.
    - domain: "*.{{ authelia_cookie_domain }}"
      policy: two_factor

session:
  cookies:
    - domain: "{{ authelia_cookie_domain }}"
      authelia_url: "{{ authelia_portal_url }}"
      expiration: "{{ authelia_session_expiration }}"
      inactivity: "{{ authelia_session_inactivity }}"
      remember_me: "{{ authelia_session_remember_me }}"

regulation:
  max_retries: 3
  find_time: "2m"
  ban_time: "5m"

storage:
  local:
    path: "{{ authelia_db_path }}"

notifier:
  # crit-1 service must not crashloop when a downstream is briefly unreachable
  # at boot; passkey-first login never touches the notifier anyway.
  disable_startup_check: true
  # Filesystem backend, not SMTP: auth-critical flows (passkey enrolment's
  # one-time code, password reset) must not depend on mail/DNS reachability in
  # a single-user homelab. The code is written here and read by the operator.
  filesystem:
    filename: "{{ authelia_notification_file }}"
